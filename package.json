{
  "name": "apt-api-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:api": "node --watch server/server.js",
    "build": "next build",
    "build:api": "node scripts/build.js",
    "start": "next start",
    "start:api": "node server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "lint": "prettier --check app components lib server tests scripts README.md package.json vercel.json next.config.ts tsconfig.json postcss.config.mjs --ignore-unknown",
    "format": "prettier --write app components lib server tests scripts README.md package.json vercel.json next.config.ts tsconfig.json postcss.config.mjs --ignore-unknown",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.7",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "engines": {
    "node": "24.x"
  }
}
