{
  "name": "apt-api-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check app components lib scripts README.md package.json vercel.json next.config.ts tsconfig.json postcss.config.mjs schema.sql --ignore-unknown",
    "format": "prettier --write app components lib scripts README.md package.json vercel.json next.config.ts tsconfig.json postcss.config.mjs schema.sql --ignore-unknown",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.7",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
